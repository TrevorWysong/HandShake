# Sandbox (test-mode) processor keys, for the spike scripts in spike/ and the
# adapters' live tests. Copy to .env and fill in -- never commit .env, and
# never use live keys here.

# Stripe test mode: https://dashboard.stripe.com/test/apikeys
# A restricted key ("Create restricted key") with only these permissions set
# to Write: PaymentIntents, SetupIntents, Customers, PaymentMethods. All else
# None.
STRIPE_RESTRICTED_KEY=
STRIPE_PUBLISHABLE_KEY=

# Square sandbox: https://developer.squareup.com/apps -> your app ->
# Sandbox -> Credentials, and Locations.
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=

# Clover sandbox: https://sandbox.dev.clover.com -> your test merchant ->
# Settings -> Ecommerce API Tokens (create one, "Hosted iframe + API").
CLOVER_SANDBOX_MERCHANT_ID=
CLOVER_SANDBOX_PUBLIC_KEY=
CLOVER_SANDBOX_PRIVATE_TOKEN=
