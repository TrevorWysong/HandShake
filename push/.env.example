# Copy to .env and fill in. Never commit .env.
# The relay's own keys: `npm run keys >> .env` makes TOKEN_KEY and a VAPID key.
TOKEN_KEY=
# How long a wake token works for. A device fetches new ones before then.
TOKEN_TTL_DAYS=30

PORT=8892
# In a folder of its own: the relay makes it, or narrows it, to its account
# alone -- and won't start in a folder others can read that holds anything else.
DB_PATH=./data/push.db
# The origins the app runs at, comma separated, allowed to call this from
# inside it: the dev server, and in production the HandShake app's own.
APP_ORIGINS=http://localhost:5173
# Behind a proxy that sets X-Forwarded-For (Caddy, in deploy/).
TRUST_PROXY=0

# Each channel is on when its credentials are set; at least one must be.
# Web Push (browsers): the key from `npm run keys`, and who to contact.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Apple (the iPhone app): a token key (.p8) from the Apple developer
# account's Keys page -- inline with \n, or @/path/to/key.p8.
APNS_PRIVATE_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
# 1 for builds signed for development.
APNS_SANDBOX=0

# Google (the Android app): the Firebase project's service account JSON --
# inline, or @/path/to/service-account.json.
FCM_SERVICE_ACCOUNT=

# Limits on each device: wakes a minute, and a day. Registrations and token
# batches one address may ask for an hour, and wakes it may ask for a minute
# (valid tokens or not).
WAKES_PER_MINUTE=4
WAKES_PER_DAY=150
REQUESTS_PER_IP_PER_HOUR=60
WAKE_REQUESTS_PER_IP_PER_MINUTE=120

# Devices one address may register a day, and the most the relay holds in
# all -- past that it refuses new ones (and logs it) rather than grow. A
# device that hasn't asked for tokens in TOKEN_TTL_DAYS is forgotten: none
# of its tokens work by then.
REGISTRATIONS_PER_IP_PER_DAY=10
MAX_DEVICES=500000
